# SLB 生产环境配置模板
# 复制此文件为 .env 并填写实际值

# 安全密钥（部署脚本会自动生成，勿使用默认值）
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
JWT_SECRET=change-me-to-another-random-string
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_CREDENTIALS_KEY=generate-a-fernet-key-for-production

# 首次启动管理员（生产环境密码至少 16 位）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-admin-password

# 数据库路径
DATABASE_PATH=/app/data/slb.db

# LLM 配置（也可在管理后台设置页面切换）
LLM_PROVIDER=stepfun
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.stepfun.com/step_plan/v1
LLM_MODEL=step-3.7-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8000
LLM_TIMEOUT=60
LLM_MAX_ATTEMPTS=1
LLM_RETRY_DELAY=0.5

# 批改后端：默认 internal；独立 worker 安装可选依赖后可设为 autorubric
GRADING_BACKEND=internal
# 首次发布保持关闭；模型逐个测试通过后再设为 true
MULTI_MODEL_ENABLED=false
MAX_MODELS_PER_SUBMISSION=4
MAX_PARALLEL_MODELS=4

# Telegram Bot（可选）
TG_BOT_TOKEN=

# Flask 环境
FLASK_DEBUG=false
FLASK_ENV=production
ENV=production
PORT=8790

# CORS（生产环境填实际域名）
# ALLOWED_ORIGINS=https://slb.19990419.top

# OCR 文字识别（手写拍照识别）
# 首选供应商: baidu | tencent | tesseract
OCR_PROVIDER=baidu
# 百度 OCR — 手写识别准确率高，免费 500 次/天
# 申请地址: https://console.bce.baidu.com/ai/#/ai/ocr/overview/index
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
# 腾讯云 OCR — 免费 1000 次/月
# 申请地址: https://console.cloud.tencent.com/ocr/overview
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=
